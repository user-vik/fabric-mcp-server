{
  "name": "fabric-mcp-server",
  "version": "2.0.0",
  "description": "Microsoft Fabric as an MCP server AND a CLI from one tool registry: workspaces, items, pipeline/notebook runs, schedules, deployment pipelines, git sync, OneLake, semantic-model connections and read-only DAX",
  "type": "module",
  "main": "index.js",
  "bin": {
    "fabric-mcp-server": "index.js",
    "fabric": "bin/fabric.js"
  },
  "scripts": {
    "start": "node index.js",
    "cli": "node bin/fabric.js",
    "test": "node --test"
  },
  "license": "MIT",
  "author": "Victor Perez",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "microsoft-fabric",
    "fabric",
    "cli",
    "data-pipeline",
    "semantic-model",
    "onelake",
    "claude",
    "anthropic"
  ],
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/identity-cache-persistence": "^1.3.2",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    ".env.example"
  ]
}
