# Copy to `.env` for local debugging, or set inside the MCP client's `env` block.
# The same variables drive both surfaces: the MCP server (index.js) and the CLI (bin/fabric.js).

# ─── Authentication ──────────────────────────────────────────────────────────
# interactive       (default) Opens a browser; for desktop devs (AVD works).
# device-code       Prints a code + URL to stderr; for SSH/WSL/headless.
# cli               Uses your existing `az login` session (Azure CLI).
# azure-powershell  Uses your existing `Connect-AzAccount` session (Az
#                   PowerShell). Use on hosts with Az PowerShell but no az CLI.
# service-principal Non-interactive, uses CLIENT_ID + CLIENT_SECRET below.
# managed-identity  For servers hosted on Azure.
# default           Tries env -> managed-identity -> CLI -> browser in turn.
FABRIC_AUTH_MODE=interactive

# Entra tenant ID. Required for interactive / device-code / service-principal.
AZURE_TENANT_ID=<your-entra-tenant-id>

# App (client) ID. Optional for interactive/device-code (defaults to Azure CLI
# public client). Required for service-principal.
AZURE_CLIENT_ID=

# Client secret. Required ONLY for service-principal.
AZURE_CLIENT_SECRET=

# ─── Token cache ─────────────────────────────────────────────────────────────
# memory      (MCP default) tokens live only in the running process.
# persistent  (CLI default) tokens are stored in the OS secure store (DPAPI on
#             Windows, Keychain on macOS, libsecret on Linux) so each CLI
#             command reuses the previous sign-in instead of opening a browser.
# The CLI sets persistent unless you override it here; the MCP server stays
# in memory unless you opt in.
#FABRIC_TOKEN_CACHE=persistent
#FABRIC_TOKEN_CACHE_NAME=fabric-mcp-server

# ─── Mode ────────────────────────────────────────────────────────────────────
# read (default) — discovery, run/refresh history, git status, definitions,
#                  connections, OneLake, and execute_dax (read-only DAX).
# write          — also enables every mutating tool (runs, refreshes, git
#                  commit/update, schedules, deployments, item create/delete,
#                  connection binding, takeover, SQL endpoint refresh, ...).
# Applies to BOTH the MCP server and the CLI: `fabric <write-tool>` refuses
# to run unless this is set, so the gate is an environment decision, not a flag.
# Note: execute_dax needs Build permission on the target semantic model and the
# tenant's "Dataset Execute Queries REST API" admin setting enabled.
FABRIC_MCP_MODE=read
